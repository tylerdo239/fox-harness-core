# Copy to .env in this directory (repo root) and fill in real values.
# Never commit .env. Auto-loaded by `dsh`, services/gateway, and
# services/orchestrator from this directory — no manual VAR=... prefix needed.

# --- LLM (packages/llm/openai-compat) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=
# OPENAI_CONTEXT_WINDOW=32000       # model context size in tokens; unset = no automatic compaction
# OPENAI_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'   # JSON merged into every request (vLLM: Qwen thinking off)
# LLM_IDLE_TIMEOUT_MS=120000        # abort a turn if no SSE chunk for this long

# --- Web search (packages/tool/serper-web-search) — key from https://serper.dev ---
SERPER_API_KEY=

# --- services/gateway ---
GATEWAY_PORT=4000
ORCHESTRATOR_URL=http://127.0.0.1:4100

# Shared with services/orchestrator — required, both refuse to boot without
# it (proves a caller hitting orchestrator directly is really gateway).
# Generate: openssl rand -hex 32
ORCHESTRATOR_INTERNAL_SECRET=

# custom_skills.content storage (services/gateway/src/object-storage.ts) —
# required, gateway refuses to boot without these. Local dev: MinIO via
# `docker compose -f infra/docker/docker-compose.dev.yml up -d minio`
# (console at http://127.0.0.1:9001, same creds as below) — values here
# already match that container. Prod: point at real AWS S3 (or R2/Spaces/
# other S3-compatible service) — leave S3_ENDPOINT unset for real AWS S3,
# and set S3_FORCE_PATH_STYLE=false (AWS supports virtual-hosted-style).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=fox-harness-skills
S3_ACCESS_KEY_ID=fox_harness
S3_SECRET_ACCESS_KEY=fox_harness_dev
S3_FORCE_PATH_STYLE=true

# DATABASE_URL=mariadb://fox_harness:fox_harness_dev@127.0.0.1:3307/fox_harness
# DB_CONNECTION_LIMIT=10
# REDIS_URL=redis://127.0.0.1:6379
# TOKEN_TTL_MS=3600000              # login token TTL (ms) — sliding, renews on activity
# AUTH_RATE_LIMIT_MAX=10            # login/register attempts allowed per window
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# ORCHESTRATOR_REQUEST_TIMEOUT_MS=10000

# --- services/orchestrator ---
ORCHESTRATOR_PORT=4100
REDIS_URL=redis://127.0.0.1:6379
WORKER_IMAGE=fox-harness-worker:dev
# ORCHESTRATOR_DATA_DIR=            # default: <repo>/data/dsh-home

# Per-worker-container resource limits
# WORKER_MEMORY_MB=2048
# WORKER_CPU_LIMIT=2
# WORKER_PIDS_LIMIT=512

WARM_POOL_SIZE=2
IDLE_TTL_MS=600000                  # hibernate idle container after this long (ms)
SWEEP_INTERVAL_MS=60000

# Quota — 0 = unlimited/off
MAX_CONCURRENT_SESSIONS=0
MAX_SESSION_AGE_MS=0
ARCHIVE_AFTER_HIBERNATED_MS=0       # hibernated longer than this -> compressed off live disk
# ORCHESTRATOR_ARCHIVE_DIR=<repo>/data/_archive
SESSION_TOKEN_BUDGET=               # per-session token cap, unset/0 = unlimited

# OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini   # comma-separated, picked at session creation
