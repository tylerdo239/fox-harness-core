# Optional overrides for the root docker-compose.yml (local development only). Copy to .env next to it.
# Secrets for the backend do NOT go here: they live in api/.env (see api/.env.example).

# WEB_PORT=8080
# LOCAL_DB_PASSWORD=fox_harness_dev      # must match the password in api/.env's DATABASE_URL
# LOCAL_DB_ROOT_PASSWORD=fox_root_dev
# LOCAL_S3_KEY=fox_harness               # must match api/.env's S3_ACCESS_KEY_ID
# LOCAL_S3_SECRET=fox_harness_dev        # must match api/.env's S3_SECRET_ACCESS_KEY
# LOCAL_MYSQL_ROOT_PASSWORD=fox_mysql_dev  # only used when the mysql volume is created
