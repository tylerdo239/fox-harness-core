# Copy to api/.env and fill in real values. Never commit .env.
# Read by the gateway when you run the code directly (`cd api && pnpm dev`), and by the `backend` service of the
# root docker-compose.yml, which overrides the infrastructure URLs below with its service names. The gateway hands
# the agent runtime only the variables it needs (runtimeEnvPassthrough in services/gateway/src/config.ts).
# The addresses below match the root docker-compose.yml's infrastructure (`docker compose up -d mariadb redis ...`).
# Production: see docs/deploy.md.

# --- LLM (packages/llm/openai-compat) --- forwarded to the agent runtime
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=
# OPENAI_CONTEXT_WINDOW=32000       # model context size in tokens; unset = no automatic compaction
# OPENAI_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'   # JSON merged into every request (vLLM: Qwen thinking off)
# LLM_IDLE_TIMEOUT_MS=120000        # abort a turn if no SSE chunk for this long

# --- Web search (packages/tool/serper-web-search) — key from https://serper.dev ---
SERPER_API_KEY=

# --- Data analysis (packages/tool/data-studio-agent, docs/data-studio-agent-transfer-plan.md)
# — forwarded into the agent runtime; the vendored Python pipeline
# (packages/tool/data-studio-agent/python) calls these itself. ---
#
# MongoDB holds Data Studio's semantic layer + chat history + dashboards
# (docs/data-studio-mongodb-plan.md). Used by gateway (admin CRUD), the admin bridge and the agent runtime. Local dev: the root docker-compose.yml's `mongo`.
# Staging/prod: put the real URI here, or let Vault inject it as `MongoDBWrite` (accepted as an
# alias). A database named in the URI path wins over MONGODB_DATABASE_NAME. Never commit a URI
# that carries credentials.
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE_NAME=bot_data_studio
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_ID=text-embedding-3-small
# Dremio — local dev: the root docker-compose.yml's `dremio` (on a fresh volume, create the admin account
# via its web UI at http://127.0.0.1:9047 first).
# Prod: point at the real enterprise Dremio deployment instead.
DREMIO_URL=http://127.0.0.1:9047
DREMIO_USERNAME=admin
DREMIO_PASSWORD=admin123
# Meilisearch — local dev: the root docker-compose.yml's `meilisearch`.
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_SEMANTIC_RATIO=0.15
# DATA_STUDIO_V3_DEBUG=0            # the pipeline's own per-run debug dump, default on

# --- services/gateway (also starts and routes to the agent runtime) ---
GATEWAY_PORT=4000

# Everything on disk: dsh logs, per-user workspaces (users/<userId>/<sessionId>), projects. Must be OUTSIDE any git
# checkout (the gateway refuses to start otherwise). Default: ~/.fox-harness/data
# GATEWAY_DATA_DIR=

# How many `dsh` runtime processes the gateway starts; a session goes to hash(sessionId) % N. One runtime tops out
# around 100-150 sessions streaming at once; raise N to use more cores.
# FOX_RUNTIME_COUNT=1
# FOX_RUNTIME_BASE_PORT=4201          # loopback ports base..base+N-1
# Required in production (NODE_ENV=production): bash/python run under a strict per-session bubblewrap sandbox.
# Linux with bubblewrap only. Off by default for local development on macOS, where model-run code is NOT confined.
# FOX_REQUIRE_SANDBOX=0

# custom_skills.content storage (services/gateway/src/object-storage.ts) —
# required, gateway refuses to boot without these. Local dev: the root
# docker-compose.yml's `minio` (console at http://127.0.0.1:9001, same creds
# as below) — values here already match that container. Prod: point at real AWS S3 (or R2/Spaces/
# other S3-compatible service) — leave S3_ENDPOINT unset for real AWS S3,
# and set S3_FORCE_PATH_STYLE=false (AWS supports virtual-hosted-style).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=fox-harness-skills
S3_ACCESS_KEY_ID=fox_harness
S3_SECRET_ACCESS_KEY=fox_harness_dev
S3_FORCE_PATH_STYLE=true

DATABASE_URL=mariadb://fox_harness:fox_harness_dev@127.0.0.1:3307/discovery-agent
# DB_CONNECTION_LIMIT=10
REDIS_URL=redis://127.0.0.1:6379
# TOKEN_TTL_MS=3600000              # login token TTL (ms) — sliding, renews on activity
# AUTH_RATE_LIMIT_MAX=10            # login/register attempts allowed per window
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# Quota — 0 = unlimited. Counted over sessions with an open browser connection.
MAX_CONCURRENT_SESSIONS=0
MAX_SESSIONS_PER_USER=0
SESSION_TOKEN_BUDGET=               # per-session token cap, unset/0 = unlimited

# Largest file accepted into a data-analysis working directory (bytes).
# MAX_UPLOAD_BYTES=73400320

# Agent runtime tuning (all optional)
# FOX_IDLE_DISPOSE_MS=600000        # an idle session with nobody connected is dropped from RAM after this long (resumes from its log)
# FOX_PY_IDLE_MS=900000             # a python kernel nobody used for this long is stopped
# FOX_PY_MAX_KERNELS=64             # live python kernels in one runtime
# FOX_DS_WORKERS=2                  # concurrent `analyze_data` questions per runtime (the rest queue)

# OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini   # comma-separated, picked at session creation
