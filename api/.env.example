# Copy to api/.env. Never commit .env. Production: docs/deploy.md.

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=
# OPENAI_ALLOWED_MODELS=
# OPENAI_CONTEXT_WINDOW=32000
# OPENAI_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
# LLM_IDLE_TIMEOUT_MS=120000

# Web search
SERPER_API_KEY=

# Data Studio
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE_NAME=bot_data_studio
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_ID=text-embedding-3-small
DREMIO_URL=http://127.0.0.1:9047
DREMIO_USERNAME=admin
DREMIO_PASSWORD=admin123
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_SEMANTIC_RATIO=0.15
# DATA_STUDIO_V3_DEBUG=0
# Data Studio pipeline: v3 (default) or v4
# DATA_STUDIO_PIPELINE=v3

# Database, Redis, S3
DATABASE_URL=mariadb://fox_harness:fox_harness_dev@127.0.0.1:3307/discovery-agent
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=fox-harness-skills
S3_ACCESS_KEY_ID=fox_harness
S3_SECRET_ACCESS_KEY=fox_harness_dev
S3_FORCE_PATH_STYLE=true
# Server-side encryption for archived session logs: AES256 or aws:kms (empty on MinIO dev)
# S3_SSE=AES256

# Session logs archived to the same bucket under sessions/ (docs/session-archive-plan.md)
# SESSION_ARCHIVE=1                       # 0 = off (logs stay only on the disk)
# SESSION_ARCHIVE_INTERVAL_MS=120000      # upload sweep
# SESSION_LOCAL_RETENTION_DAYS=30         # an archived log / working folder untouched this long leaves the disk (0 = never)
# Admin usage dashboard (/admin/usage, docs/admin-usage-dashboard-plan.md). Needs api/migrations/002_usage.sql.
# USAGE_INGEST=1                           # 0 = do not load the runtimes' usage records into MariaDB
# USAGE_INGEST_INTERVAL_MS=60000
# USAGE_RETENTION_DAYS=400                 # usage rows older than this are deleted (0 = keep)
# USAGE_UTC_OFFSET_MINUTES=420             # report days at +07:00 (Asia/Ho_Chi_Minh)
# USAGE_REPORT_CACHE_MS=30000
# Working-folder files (uploads, python output) go to the same bucket under files/ (docs/workspace-archive-plan.md)
# WORKSPACE_ARCHIVE_MAX_FILE_BYTES=104857600   # a bigger file stays on the disk only
# Keeping a fixed-size bucket from filling up (docs/storage-quota-plan.md)
# USER_FILE_QUOTA_BYTES=209715200     # 200 MB: one user's files (uploads + chat outputs); past it uploads are refused (0 = no limit)
# S3_BUCKET_CAPACITY_BYTES=0          # the bucket's size, e.g. 12884901888 for 12 GB; 0 = not measured, not limited
# STORAGE_WARN_PERCENT=80             # storage_usage logged at warn from here
# STORAGE_BLOCK_PERCENT=95            # every upload refused from here
# STORAGE_SCAN_INTERVAL_MS=3600000    # how often the bucket is measured (one listing of every object)
# FILE_RETENTION_DAYS=0               # delete the files of chats/projects unused this long, on every scan (0 = never)
# CANVAS_HISTORY_MAX=10               # canvas panel history kept per canvas in .canvas/ (snapshots, saved edits; docs/canvas-storage-plan.md)
# DB_CONNECTION_LIMIT=10

# Gateway
GATEWAY_PORT=4000
# Log lines: json (default, for a log collector) | text (one readable line per event, for kubectl logs)
# LOG_FORMAT=json
# One `http_request` line per API call (method, path, status, ms); off silences them
# LOG_HTTP=on
# GATEWAY_DATA_DIR=
# TOKEN_TTL_MS=3600000
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_IP_RATE_LIMIT_MAX=50
# TRUST_PROXY=0
# ALLOWED_ORIGINS=
# MAX_JSON_BODY_BYTES=1048576
# MAX_IMPORT_BODY_BYTES=20971520
# CHAT_RATE_LIMIT_PER_MIN=20
# COSTLY_RATE_LIMIT_PER_MIN=10
# MAX_UPLOAD_BYTES=52428800

# Runtime and quota (0 = unlimited)
# FOX_RUNTIME_COUNT=1
# FOX_RUNTIME_BASE_PORT=4201
# FOX_REQUIRE_SANDBOX=0
# Sandbox for model-run bash/python: strict (bubblewrap, needs SYS_ADMIN+NET_ADMIN) | none (NO isolation, internal tests)
# FOX_SANDBOX_MODE=strict
# FOX_NOCONFINE_MEMORY_MB=4096
# FOX_NOCONFINE_CPU_SECONDS=3600
MAX_CONCURRENT_SESSIONS=0
MAX_SESSIONS_PER_USER=0
SESSION_TOKEN_BUDGET=
# FOX_IDLE_DISPOSE_MS=600000
# FOX_PY_IDLE_MS=900000
# FOX_PY_MAX_KERNELS=64
# Memory for the agent's Python, worker processes included (packages/tool/python-repl/src/memory.ts).
# FOX_PY_MEMORY_MB: all chats of the service together (default 70% of the container); a chat over it
# (the biggest running one first) has its workers stopped, then its code interrupted, then its session.
# FOX_PY_SESSION_MEMORY_MB: one chat (default half of FOX_PY_MEMORY_MB). 0 turns a limit off.
# FOX_PY_MEMORY_MB=2048
# FOX_PY_SESSION_MEMORY_MB=768
# FOX_DS_WORKERS=2
