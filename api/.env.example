# Copy to api/.env. Never commit .env. Production: docs/deploy.md.

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=
# OPENAI_ALLOWED_MODELS=
# OPENAI_CONTEXT_WINDOW=32000
# OPENAI_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
# LLM_IDLE_TIMEOUT_MS=120000

# Web search
SERPER_API_KEY=

# Data Studio
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE_NAME=bot_data_studio
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_ID=text-embedding-3-small
DREMIO_URL=http://127.0.0.1:9047
DREMIO_USERNAME=admin
DREMIO_PASSWORD=admin123
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_SEMANTIC_RATIO=0.15
# DATA_STUDIO_V3_DEBUG=0
# Data Studio pipeline: v3 (default) or v4
# DATA_STUDIO_PIPELINE=v3

# Database, Redis, S3
DATABASE_URL=mariadb://fox_harness:fox_harness_dev@127.0.0.1:3307/discovery-agent
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=fox-harness-skills
S3_ACCESS_KEY_ID=fox_harness
S3_SECRET_ACCESS_KEY=fox_harness_dev
S3_FORCE_PATH_STYLE=true
# DB_CONNECTION_LIMIT=10

# Gateway
GATEWAY_PORT=4000
# GATEWAY_DATA_DIR=
# TOKEN_TTL_MS=3600000
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_IP_RATE_LIMIT_MAX=50
# TRUST_PROXY=0
# ALLOWED_ORIGINS=
# MAX_JSON_BODY_BYTES=1048576
# MAX_IMPORT_BODY_BYTES=20971520
# CHAT_RATE_LIMIT_PER_MIN=20
# COSTLY_RATE_LIMIT_PER_MIN=10
# MAX_UPLOAD_BYTES=73400320

# Runtime and quota (0 = unlimited)
# FOX_RUNTIME_COUNT=1
# FOX_RUNTIME_BASE_PORT=4201
# FOX_REQUIRE_SANDBOX=0
# Sandbox for model-run bash/python: strict (bubblewrap, needs SYS_ADMIN+NET_ADMIN) | none (NO isolation, internal tests)
# FOX_SANDBOX_MODE=strict
# FOX_NOCONFINE_MEMORY_MB=4096
# FOX_NOCONFINE_CPU_SECONDS=3600
MAX_CONCURRENT_SESSIONS=0
MAX_SESSIONS_PER_USER=0
SESSION_TOKEN_BUDGET=
# FOX_IDLE_DISPOSE_MS=600000
# FOX_PY_IDLE_MS=900000
# FOX_PY_MAX_KERNELS=64
# FOX_DS_WORKERS=2
