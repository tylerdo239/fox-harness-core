# api/Dockerfile builds from api/ and reinstalls
# dependencies inside the image — node_modules here would only add weight and
# platform mismatches. .env must never enter a build context: real credentials
# reach the backend only at `docker run` time, never baked into an image layer.
node_modules/
**/lib/
**/dist/
*.tsbuildinfo
# packages/tool/data-studio-agent/python's venv — a host-built one would be
# linked to the HOST's python interpreter (e.g. macOS), useless (and
# discarded/rebuilt anyway) inside the Linux image; excluding it just avoids
# uploading it into the build context.
**/.venv/
**/__pycache__/
.git/
.env
.env.*
!.env.example
data/
# the data-studio pipeline's per-run markdown traces
packages/tool/data-studio-agent/python/debug/
