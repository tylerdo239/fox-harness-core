{
  "name": "fox-harness-core",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types services/gateway/src/index.ts",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "test:llm": "node --experimental-transform-types --no-warnings --test --test-force-exit packages/llm/openai-compat/test/repair.test.ts",
    "test:memory": "node --experimental-transform-types --no-warnings --test --test-force-exit services/gateway/test/memory.unit.test.ts services/gateway/test/memory.integration.test.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@fox-harness/dsh-agent-core": "workspace:*",
    "@fox-harness/dsh-flow-data-analysis": "workspace:*",
    "@fox-harness/dsh-llm-openai-compat": "workspace:*",
    "@fox-harness/dsh-tool-serper-web-search": "workspace:*",
    "@fox-harness/dsh-tool-create-skill": "workspace:*",
    "@fox-harness/dsh-tool-python-repl": "workspace:*",
    "@fox-harness/dsh-tool-data-studio-agent": "workspace:*",
    "@fox-harness/dsh-tool-canvas": "workspace:*",
    "@fox-harness/dsh-tool-file-manage": "workspace:*",
    "@fox-harness/dsh-memory": "workspace:*"
  }
}
