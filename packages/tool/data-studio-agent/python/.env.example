# Only needed to run bridge/runner.py directly for local/manual testing
# (`uv run python bridge/runner.py`, feeding it `{"question": "..."}` lines
# on stdin) — fox itself never reads this file. In real use,
# packages/tool/data-studio-agent spawns that same script as a subprocess of
# the worker container, which forwards these same values as real env vars
# (services/orchestrator/src/config.ts's workerEnvPassthrough); see
# docs/data-studio-agent-transfer-plan.md.
#
# There is no HTTP app/server left in this service (the vendored FastAPI
# layer — auth, routes, main.py — was removed as unused: fox only ever calls
# run_pipeline_v3() in-process via bridge/runner.py).

# ── LLM (chat / SQL agents) — OpenAI-compatible endpoint. Default: reuse
# the SAME endpoint fox's own chat flow uses (root .env's OPENAI_*) — the
# pipeline needs real tool-calling support, so switch to a stronger/
# dedicated model here later if the shared one isn't reliable enough for
# the 12-step agent pipeline. ──
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=
OPENAI_EXTRA_BODY={}

# ── Embeddings (retrieval) — OpenAI-compatible endpoint ──
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_ID=text-embedding-3-small

# ── Database — SQLite. Fox's own integration overrides this with a fixed path
# on a shared mount (services/orchestrator/src/docker.ts); standalone default: ──
# DATABASE_URL=sqlite:///./data/semantic_layer.db

# ── Dremio (data plane + metadata sync source) — local dev:
# infra/docker/docker-compose.dev.yml's `dremio` service. Prod: point at
# the real enterprise Dremio deployment instead. ──
DREMIO_URL=http://localhost:9047
DREMIO_USERNAME=admin
DREMIO_PASSWORD=admin123

# ── Meilisearch (hybrid keyword+semantic retrieval) — local dev:
# infra/docker/docker-compose.dev.yml's `meilisearch` service. ──
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_SEMANTIC_RATIO=0.15
