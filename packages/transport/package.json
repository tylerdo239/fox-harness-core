    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@fox-harness/contracts": "workspace:*",
    "ws": "8.21.3"
  }
