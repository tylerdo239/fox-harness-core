node_modules/
# tsc output of api/ packages and app/; NOT app/src/ref/lib/, which is source (the Data Profile screens import
# @/lib/api, @/lib/types, ... from it — ignored by mistake from a60c984 until 2026-10-15, so a clean clone failed to build)
lib/
!/app/src/ref/lib/
dist/
*.tsbuildinfo
*.log
.DS_Store
.env
.env.*
!.env.example
.claude/
examples/

# services/data-studio-agent (vendored Python, uv-managed)
.venv/
__pycache__/
*.pyc
# the data-studio pipeline writes a markdown trace per run (pipeline_v3) — runtime output
api/packages/tool/data-studio-agent/python/debug/

# services/orchestrator's per-session $DSH_HOME directories (materialize.ts,
# ORCHESTRATOR_DATA_DIR default) — runtime data, never committed.
/data/

# Benchmark run output and its data files (docs/bench.md): reports are generated on every
# run, and the fixtures are third-party tables plus a generated workbook — both come back
# with `node scripts/bench/fetch-fixtures.mjs`, so neither belongs in the repo.
/api/scripts/bench/reports/
/api/scripts/bench/fixtures/

# app/: build output (vite.config.ts; app/Dockerfile builds it) — dist/ is ignored above
/app/public/ref.css
/app/public/tw.css

# Local benchmark cases (DABStep and its variants, repros), not part of the shared suite
/api/scripts/bench/cases/dabstep-*.json
/api/scripts/bench/cases/dabx-*.json
/api/scripts/bench/cases/repro-*.json
/app/.parity/
