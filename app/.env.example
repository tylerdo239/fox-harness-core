# Copy to app/.env. Never commit .env (the UI holds no secret, but keep the habit).
#
# Where the backend gateway is. The page always calls its own origin; the API paths and the chat WebSocket are
# forwarded here — by the dev server (`pnpm dev`, reads this file) and by nginx in the web container (reads it
# from the container's environment).
#   pnpm dev (code run directly):  the gateway from `cd api && pnpm dev`
#   root docker-compose.yml:       overridden to http://backend:4000 (the compose service name)
#   production:                    the backend's internal address, e.g. http://fox-backend:4000
BACKEND_URL=http://127.0.0.1:4000

# Dev server port (pnpm dev).
# PORT=5173
