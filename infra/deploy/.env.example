# Copy to infra/deploy/.env and fill in. Read by the backend container only (the web container needs nothing).
# Variables the gateway and the agent runtime understand are documented in the repo-root .env.example.

# --- Required ---------------------------------------------------------------------------------------------
# MariaDB (database `discovery-agent`, schema from infra/migrations/001_init.sql). The `mariadb://` scheme is required.
DATABASE_URL=mariadb://user:password@mariadb-host:3306/discovery-agent
REDIS_URL=redis://redis-host:6379
# S3-compatible bucket for per-user skills. Leave S3_ENDPOINT unset for real AWS S3.
S3_BUCKET=fox-harness-skills
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
# The LLM (any OpenAI-compatible /chat/completions endpoint).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=

# --- Agent runtime ----------------------------------------------------------------------------------------
# How many `dsh` processes the backend runs. One tops out around 100-150 sessions STREAMING at the same time;
# raise it to use more cores (sessions are spread over them by hash).
FOX_RUNTIME_COUNT=1
# 0 = unlimited. Counted over sessions with an open browser connection.
MAX_CONCURRENT_SESSIONS=0
MAX_SESSIONS_PER_USER=0
# OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini
# SESSION_TOKEN_BUDGET=

# --- Optional tools ---------------------------------------------------------------------------------------
SERPER_API_KEY=
MONGODB_URL=mongodb://mongo-host:27017
MONGODB_DATABASE_NAME=bot_data_studio
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_ID=text-embedding-3-small
DREMIO_URL=
DREMIO_USERNAME=
DREMIO_PASSWORD=
MEILISEARCH_URL=
MEILISEARCH_MASTER_KEY=
